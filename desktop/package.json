{
  "name": "quicklaunch-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "QuickLaunch desktop shell - wraps the shared web bundle with Electron",
  "main": "main.js",
  "homepage": "https://github.com/luty4ng/QuickLaunchTemplate",
  "author": {
    "name": "QuickLaunch",
    "email": "luty4ng@users.noreply.github.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luty4ng/QuickLaunchTemplate.git"
  },
  "scripts": {
    "stage": "node scripts/stage-web.mjs",
    "stamp": "node scripts/stamp-version.mjs",
    "start": "npm run stage && electron .",
    "pack": "npm run stage && electron-builder --dir",
    "dist": "npm run stage && electron-builder --win --linux",
    "dist:win": "npm run stage && electron-builder --win",
    "dist:linux": "npm run stage && electron-builder --linux",
    "test": "node --test lib/version.test.js"
  },
  "build": {
    "appId": "dev.quicklaunch.desktop",
    "productName": "QuickLaunch",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "web-dist",
        "to": "web-dist"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "QuickLaunch-Setup-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "QuickLaunch <luty4ng@users.noreply.github.com>",
      "artifactName": "QuickLaunch-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "luty4ng",
      "repo": "QuickLaunchTemplate",
      "releaseType": "release"
    },
    "electronUpdaterCompatibility": ">=2.16"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  }
}
