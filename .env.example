# Copy to .env and adjust. Never commit the real .env.

# --- API ---------------------------------------------------------------
APP_ENV=development
PORT=8000

# Where the built web client lives. The container sets /app/web/dist itself.
WEB_DIST=web/dist

# --- Database ----------------------------------------------------------
# Local default is sqlite so a laptop needs no Docker. CI and production use
# postgres 16, which is the only configuration that is allowed to ship.
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# postgresql+psycopg://quicklaunch:quicklaunch@localhost:5432/quicklaunch

# Run `alembic upgrade head` on boot. Convenient locally, OFF in production
# where migrations are their own pipeline step.
AUTO_MIGRATE=true

# --- Sessions ----------------------------------------------------------
# Must be at least 32 characters for HS256. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_TTL_SECONDS=604800

# bcrypt cost. 12 in production; tests lower it to keep the suite fast.
BCRYPT_ROUNDS=12

# --- Cookies / CORS ----------------------------------------------------
COOKIE_SECURE=false
# Comma separated extra origins allowed to call the API with credentials.
# Needed only when a client is served from another origin, e.g. the Android
# build: http://localhost,https://localhost,capacitor://localhost
CORS_ORIGINS=

# --- Deployment (docker compose) ---------------------------------------
APP_IMAGE=ghcr.io/luty4ng/quicklaunchtemplate:latest
APP_PORT=8000
POSTGRES_USER=quicklaunch
POSTGRES_PASSWORD=quicklaunch
POSTGRES_DB=quicklaunch
